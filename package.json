{
  "name": "lark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:lib": "tsup --config packages/lark/tsup.config.ts",
    "pack:lib": "npm run build:lib && npm pack ./packages/lark --pack-destination ./packages",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens": "python design/tokens/build_tokens.py",
    "smoke:lib": "node packages/lark/scripts/smoke.mjs",
    "lint:lark": "node packages/lark/scripts/lark-lint.mjs src/components/lark src/app/examples",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run lint:lark && npm run typecheck && npm test && npm run build:lib && npm run smoke:lib"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.41",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.26.1",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.0",
    "ai": "^6.0.105",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.9.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "media-chrome": "^4.17.2",
    "motion": "^12.26.2",
    "nanoid": "^5.1.6",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-jsx-parser": "^2.2.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "shiki": "3.22.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.3",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
